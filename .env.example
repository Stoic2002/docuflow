DATABASE_URL=postgres://localhost:5432/pdf_web_studio?sslmode=disable
# Supabase transaction-pooler alternative (put the real password only in ignored .env):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
TEST_DATABASE_URL=
API_ADDR=127.0.0.1:8080
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Paths are resolved from apps/api when using make dev-api.
STORAGE_ROOT=../../data
MAX_UPLOAD_BYTES=52428800
REQUEST_TIMEOUT=30s
PROCESSING_TIMEOUT=5m
# Optional commercial engine selection. No key is committed.
VITE_PDF_ENGINE=fallback
VITE_APRYSE_LICENSE_KEY=
VITE_NUTRIENT_LICENSE_KEY=
